{
  "name": "chatpony",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node node_modules/next/dist/bin/next typegen && tsc --noEmit",
    "test": "bun test",
    "admin:create": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/create-admin.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "lucide-react": "^0.468.0",
    "lunar-javascript": "1.7.7",
    "next": "^16.0.0",
    "nodemailer": "^10.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
