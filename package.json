{
  "name": "chatpony",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && bun run dev",
    "build:frontend": "cd frontend && bun run build",
    "test:frontend": "cd frontend && bun run typecheck && bun run test",
    "dev:backend": "cargo run --manifest-path backend/Cargo.toml --bin chatpony",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "create-admin": "cargo run --manifest-path backend/Cargo.toml --bin create-admin --",
    "backup": "cargo run --manifest-path backend/Cargo.toml --bin backup --"
  }
}
