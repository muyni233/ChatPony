{
  "name": "chatpony",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "dev:lan": "bun --bun next dev --webpack --hostname 0.0.0.0 --port 3218",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.ts *.md *.yaml",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md *.yaml",
    "test": "bun test",
    "admin:create": "bun scripts/create-admin.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.3.8",
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
