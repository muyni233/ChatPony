# Persistent SQLite file. Run this app with Bun, not Node.
DATABASE_PATH=./data/chatpony.db
# Optional override. If empty, a persistent key is created beside the database in all modes.
# To provide one explicitly: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set true only behind a trusted proxy that overwrites X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=false
