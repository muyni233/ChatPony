# Persistent SQLite file. Run this app with Bun, not Node.
DATABASE_PATH=./data/chatpony.db
# Required in production; generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
